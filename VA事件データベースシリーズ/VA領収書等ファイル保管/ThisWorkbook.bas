' 変数の宣言を強制する
Option Explicit

'--------------------------------------------------
' 概要: ブックが開かれたときの処理
' 引数: なし
' 戻り値: なし
'--------------------------------------------------
' ワークブックを開いた時のイベントプロシージャ
Private Sub Workbook_Open()
    
    ' エラーが発生した場合はErrHandlerラベルへジャンプする
    On Error GoTo ErrHandler
    
    ' イベント処理および画面更新を一時的に無効化する
    Evnt.Disable
       
    ' 保管シートをアクティブにする
    ShtHokan.Activate

    ' ListObject型の変数tblを宣言する
    Dim tbl As ListObject
    ' 保管シートのテーブル「保管」をtblにセットする
    Set tbl = ShtHokan.ListObjects("保管")
    ' 行番号用の長整数型変数rを宣言する
    Dim r As Long
    
    ' テーブルのデータ行数分だけループ処理を行う
    For r = 1 To tbl.ListRows.Count
        ' 「保管日時」が空欄の行を見つけたらループを抜ける
        If tbl.ListColumns("保管日時").DataBodyRange(r).Value = "" Then Exit For
    ' 次の行の判定に進む
    Next

    ' 空欄の行がテーブル内に存在した場合
    If r <= tbl.ListRows.Count Then
        ' 該当行の「種別」セルを選択状態にする
        tbl.ListColumns("種別").DataBodyRange(r).Select
        ' 選択した行が画面内に表示されるようにスクロールする
        ActiveWindow.ScrollRow = tbl.ListColumns("種別").DataBodyRange(r).Row
    ' 条件分岐を終了する
    End If
    
    ' 日次バックアップ処理を呼び出す
    basSetup.PerformDailyBackup

    ' イベント処理および画面更新を有効化して元に戻す
    Evnt.Enable
    ' エラーがなければプロシージャを終了する
    Exit Sub

' エラー処理用のラベル
ErrHandler:
    ' エラー内容をメッセージボックスで表示する
    MsgBox "起動プロセスの中でエラーが発生しました。" & vbCrLf & Err.Description, vbCritical, "ファイル保管"
    ' イベント処理および画面更新を有効化して元に戻す
    Evnt.Enable
' プロシージャを終了する
End Sub

'--------------------------------------------------
' 概要: ワークブック終了前にオブジェクトを解放します。
' 引数: Cancel (Boolean)
' 戻り値: なし
'--------------------------------------------------
' ワークブックを閉じる直前のイベントプロシージャ
Private Sub Workbook_BeforeClose(Cancel As Boolean)
    ' Evntオブジェクトをメモリから解放する
    Set Evnt = Nothing
' プロシージャを終了する
End Sub