'================================================================================
' モジュール名: ThisWorkbook
' 概要:         ブック全体に関わるイベント（開く、保存、閉じる等）を制御する
'               クラスモジュールです。セキュリティ対策（保存時のデータ削除）や
'               起動時の初期化処理を管理します。
' 更新日時:     2026/03/11 11:30
'================================================================================

'================================================================================
' イベント:     Workbook_Open
' 機能:         ブックオープン時の初期化
' 概要:         起動時に「事件」シートをアクティブにし、バックアップを実行します。
'================================================================================
Private Sub Workbook_Open()
    'エラー発生時にエラーハンドラへ移動するように設定します
    On Error GoTo ErrHandler

    'メインとなる「事件」シート（sht11）をアクティブ（表示状態）にします
    sht11.Activate
        
    'イベントの発生、画面更新、自動計算を停止して処理速度を向上させるクラスメソッドを呼び出します
    Evnt.Disable
    
    'バックアップを実行します
    '※PerformDailyBackup内でデータ有無を確認し、データがある場合のみ実行されます
    Setup.PerformDailyBackup
    
    '停止していたイベント、画面更新、自動計算を再開させるクラスメソッドを呼び出します
    Evnt.Enable
    
    'プロシージャを正常終了します
    Exit Sub

ErrHandler:
    'エラーが発生した場合、メッセージボックスでユーザーに詳細を通知します
    MsgBox "起動プロセスの途中でエラーが発生しました。" & vbCrLf & Err.Description, vbCritical, "事件データベース"
    
    'エラー時でもExcelが操作不能にならないよう、イベントや画面更新を再開させます
    Evnt.Enable
End Sub


'================================================================================
' イベント:     Workbook_BeforePrint
' 機能:         印刷範囲の自動調整
'================================================================================
Private Sub Workbook_BeforePrint(Cancel As Boolean)
    'アクティブなシートが「事件メモ」（sht12）でない場合は処理を終了します
    If ActiveSheet.CodeName <> "sht12" Then Exit Sub
    
    '処理中の描画などを停止します
    Evnt.Disable
    
    '2ページ目の項目（依頼者氏名、相手方氏名、代理人氏名）がすべて空欄か確認します
    If Range("依頼者氏名2ページ目").Value = "" And _
       Range("相手方氏名2ページ目").Value = "" And _
       Range("代理人氏名2ページ目").Value = "" Then
        
        '2ページ目が空欄の場合、印刷範囲を1ページ目（58行目まで）に設定します
        sht12.PageSetup.PrintArea = "$A$1:$I$58"
    '2ページ目にデータがある場合です
    Else
        '印刷範囲を2ページ目（116行目まで）を含めるように設定します
        sht12.PageSetup.PrintArea = "$A$1:$I$116"
    '条件分岐を終了します
    End If
    
    '停止していたイベント等を再開します
    Evnt.Enable
End Sub

'================================================================================
' イベント:     Workbook_BeforeClose
' 機能:         ブック終了時の処理
'================================================================================
Private Sub Workbook_BeforeClose(Cancel As Boolean)
    'イベント制御クラスのインスタンスを解放します
    Set Evnt = Nothing
    'フォルダ操作クラスのインスタンスを解放します
    Set Fldr = Nothing
End Sub


