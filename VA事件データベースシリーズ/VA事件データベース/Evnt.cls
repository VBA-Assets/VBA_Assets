Option Explicit

'================================================================================
' モジュール名: Evnt
' 概要:         Excelアプリケーションのイベント制御を行うクラスモジュールです。
'               マクロ実行中の画面更新、イベント発生、自動計算を一時停止し、
'               処理パフォーマンスを向上させます。
' 更新日時:     2026/02/01 05:37
'================================================================================

'================================================================================
' プロシージャ: Disable
' 機能:         Excelの各機能を停止
' 概要:         画面更新、マウスカーソル待機状態、イベント発生、自動計算を
'               停止し、マクロの実行速度を向上させます。
'================================================================================
Sub Disable()
    With Application
        .ScreenUpdating = False
        .Cursor = xlWait
        .EnableEvents = False
        .Calculation = xlCalculationManual
    End With
End Sub

'================================================================================
' プロシージャ: Enable
' 機能:         Excelの各機能を再開
' 概要:         Disableメソッドで停止した各機能を元の状態（自動計算、
'               イベント有効、画面更新有効）に戻します。
'================================================================================
Sub Enable()
    With Application
        .Calculation = xlCalculationAutomatic
        .EnableEvents = True
        .Cursor = xlNormal
        .ScreenUpdating = True
    End With
End Sub