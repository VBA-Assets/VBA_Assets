Option Explicit

'--------------------------------------------------
' 概要 : ワークブックを開いた場合に処理を行う
' 引数 : なし
' 戻り値 : なし
'--------------------------------------------------
Private Sub Workbook_Open()
    '「電話メモ」シートを対象
    With sht11
        '「電話メモ」シートをアクティブにする
        .Activate
        
        'イベントの発生、画面更新、自動計算を停止して処理速度を向上させるクラスメソッドを呼び出します
        Evnt.Disable
        
        'バックアップを実行します
        '※PerformDailyBackup内でデータ有無を確認し、データがある場合のみ実行されます
        Setup.PerformDailyBackup
        
        '停止していたイベント、画面更新、自動計算を再開させるクラスメソッドを呼び出します
        Evnt.Enable
    End With
End Sub


'================================================================================
' イベント:  Workbook_BeforeClose
' 機能:      ブックが閉じられる直前の処理
' 概要:      オブジェクトの解放を行います。
'================================================================================
Private Sub Workbook_BeforeClose(Cancel As Boolean)
    ' グローバルオブジェクトの解放
    ' Setupモジュールで宣言されたEvntオブジェクトを解放
    Set Evnt = Nothing
End Sub
