'================================================================================
' イベント:  Workbook_Open
' 機能:      ブックが開かれたときの処理
' 概要:      初期設定を行い、データのバックアップ処理を呼び出します。
'================================================================================
Private Sub Workbook_Open()
    '--- 前処理 ---
    ' エラーが発生した場合は、HandleErr へ進む（Ver709 まで、この行がなく、エラー処理に届かなかった）
    On Error GoTo HandleErr

    ' イベント等の停止
    Evnt.Disable
       
    ' 「保管」シートをアクティブにする
    Sht1Hokan.Activate

    '--- メイン処理 ---
    ' 処理対象行を選択する
    Dim r As Long
    Dim wsHokan As Worksheet
    Set wsHokan = Sht1Hokan
    
    ' 保管日時が空欄の最初の行を探す
    For r = 1 To Range("保管").Rows.Count
        If Range("保管[保管日時]")(r).Value = "" Then Exit For
    Next

    ' 行が見つかった場合、その行を表示する
    If r <= Range("保管").Rows.Count Then
        ' オブジェクト変数を使用して選択（ScrollRowのためにSelectは維持するが最小限に）
        Range("保管[事件呼名]")(r).Select
        ActiveWindow.ScrollRow = r
    End If
    
    ' バックアップを実行します
    Setup.PerformDailyBackup

Cleanup:
    '--- 後処理 ---
    ' イベント等を、停止する前の値に戻す（エラーのときも通る）
    On Error Resume Next
    Evnt.Enable
    Exit Sub

HandleErr:
    ' エラーの番号と内容を表示して、後処理へ進む
    MsgBox "ブックを開くときの処理でエラーが発生しました。" & vbCrLf & _
           "エラー番号：" & Err.Number & vbCrLf & _
           "内容：" & Err.Description, vbExclamation, strAppTitle
    Resume Cleanup
End Sub


'================================================================================
' イベント:  Workbook_BeforeClose
' 機能:      ブックが閉じられる直前の処理
' 概要:      オブジェクトの解放を行います。
'================================================================================
Private Sub Workbook_BeforeClose(Cancel As Boolean)
    ' グローバルオブジェクトの解放
    ' Setupモジュールで宣言されたEvntオブジェクトを解放
    Set Evnt = Nothing
End Sub
