'================================================================================
' イベント:  Workbook_Open
' 機能:      ブックが開かれたときの処理
' 概要:      初期設定を行い、データのバックアップ処理を呼び出します。
'================================================================================
Private Sub Workbook_Open()
    ' イベント等の停止
    Evnt.Disable
       
    ' 「保管」シートをアクティブにする
    Sht1Hokan.Activate

    ' 処理対象行を選択する
    Dim r As Long
    Dim wsHokan As Worksheet
    Set wsHokan = Sht1Hokan
    
    ' 保管日時が空欄の最初の行を探す
    For r = 1 To Range("保管").Rows.Count
        If Range("保管[保管日時]")(r).Value = "" Then Exit For
    Next

    ' 行が見つかった場合、その行を表示する
    If r <= Range("保管").Rows.Count Then
        ' オブジェクト変数を使用して選択（ScrollRowのためにSelectは維持するが最小限に）
        Range("保管[事件呼名]")(r).Select
        ActiveWindow.ScrollRow = r
    End If
    
    ' バックアップを実行します
    Setup.PerformDailyBackup

    ' イベント等の再開
    Evnt.Enable
    
    ' プロシージャを正常終了
    Exit Sub
ErrHandler:
    ' エラーが発生した場合、メッセージボックスで通知
    MsgBox "起動プロセスの途中でエラーが発生しました。" & vbCrLf & Err.Description, vbCritical, "ファイル保管"
    
    ' エラー時でもExcelが操作不能にならないよう、イベントや画面更新を再開させる
    Evnt.Enable
End Sub


'================================================================================
' イベント:  Workbook_BeforeClose
' 機能:      ブックが閉じられる直前の処理
' 概要:      オブジェクトの解放を行います。
'================================================================================
Private Sub Workbook_BeforeClose(Cancel As Boolean)
    ' グローバルオブジェクトの解放
    ' Setupモジュールで宣言されたEvntオブジェクトを解放
    Set Evnt = Nothing
End Sub
