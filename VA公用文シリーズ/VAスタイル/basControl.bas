'//==================================================================================================
'// 機能: Word文書のスタイルと書式設定を制御します。
'//
'// 概要: このモジュールには、オプション設定フォームの表示、スタイルや書式設定、
'//        選択範囲のフォントや傍点の切り替えを制御するためのプロシージャが含まれています。
'//==================================================================================================
Option Explicit

'//==================================================================================================
'// プロシージャ: ShowStyleOption
'// 機能:        オプション設定用のユーザーフォームを表示します。
'//
'// 概要:        ConfigOptionという名前のユーザーフォームをモーダルで表示します。
'//==================================================================================================
Sub ShowStyleOption()
    'フォームを表示する
    frmStyleOption.Show
End Sub

'//==================================================================================================
'// プロシージャ: ChangeForward
'// 機能:        見出しスタイルを次の段階へ順次変更します。
'//
'// 概要:        テキストが選択されている場合はフォントを切り替え、選択されていない場合は
'//              ConfigStyleプロシージャを呼び出して、見出しレベルを1段階進めます。
'//              処理中はマウスポインタを待機状態にし、必要に応じてマクロの中断を無効にします。
'//==================================================================================================
Sub ChangeForward()
    'テキスト範囲が選択されている場合
    If Selection.Type = wdSelectionNormal Then
        'フォントをトグルする
        Call ToggleSelectionFont
    'テキスト範囲が選択されていない場合
    Else
        '前進モードでスタイルを設定する
        Call ConfigStyle(1)
    End If
    
End Sub

'//==================================================================================================
'// プロシージャ: ChangeBackward
'// 機能:        見出しスタイルを前の段階へ順次戻します。
'//
'// 概要:        テキストが選択されている場合は傍点を切り替え、選択されていない場合は
'//              ConfigStyleプロシージャを呼び出して、見出しレベルを1段階戻します。
'//              処理中はマウスポインタを待機状態にし、必要に応じてマクロの中断を無効にします。
'//==================================================================================================
Sub ChangeBackward()

    If Selection.Type = wdSelectionNormal Then
        '強調（傍点）をトグルする
        ToggleSelectionEmphasis
    'テキスト範囲が選択されていない場合
    Else
        '後退モードでスタイルを設定する
        Call ConfigStyle(-1)
    End If
End Sub


'//==================================================================================================
'// プロシージャ: ToggleSelectionFont
'// 機能:        選択範囲のフォントを標準フォントと太字フォントで切り替えます。
'//
'// 概要:        選択範囲の先頭文字のフォント名を判定し、選択範囲全体のフォントを
'//              もう一方のフォントに設定します。
'//==================================================================================================
Private Sub ToggleSelectionFont()
    With Selection
        '最初の文字のフォントが「標準」の場合
        If .Range.Characters.First.Font.Name = strFont Then
            '選択範囲のフォントを「太字」に変更する
            .Font.Name = strBoldFont
        '最初の文字のフォントが「標準」以外の場合
        Else
            '選択範囲のフォントを「標準」に変更する
            .Font.Name = strFont
        End If
    End With
End Sub

'//==================================================================================================
'// プロシージャ: ToggleSelectionEmphasis
'// 機能:        選択範囲の傍点（強調点）の有無を切り替えます。
'//
'// 概要:        選択範囲の先頭文字に傍点がない場合は設定し、ある場合は削除します。
'//              設定する傍点の種類は変数 strEmphasis に従います。
'//==================================================================================================
Private Sub ToggleSelectionEmphasis()
    With Selection
        '最初の文字に傍点がない場合
        If .Range.Characters.First.Font.EmphasisMark = wdEmphasisMarkNone Then
            '傍点を追加する（種類は変数で指定）
            If strEmphasis = "点" Then
                .Font.EmphasisMark = wdEmphasisMarkOverComma
            Else
                .Font.EmphasisMark = wdEmphasisMarkOverSolidCircle
            End If
        '最初の文字に傍点がある場合
        Else
            '傍点を削除する
            .Font.EmphasisMark = wdEmphasisMarkNone
        End If
    End With
End Sub

'//==================================================================================================
'// ▼ここからリボン用コールバック
'//==================================================================================================

'//==================================================================================================
'// プロシージャ: RxBtnChangeForward
'// 機能:        リボン「進む」ボタンのクリック時処理
'//==================================================================================================
Sub RxBtnChangeForward(control As Object)
    Call ChangeForward
End Sub

'//==================================================================================================
'// プロシージャ: RxBtnChangeBackward
'// 機能:        リボン「戻る」ボタンのクリック時処理
'//==================================================================================================
Sub RxBtnChangeBackward(control As Object)
    Call ChangeBackward
End Sub

'//==================================================================================================
'// プロシージャ: RxBtnShowStyleOption
'// 機能:        リボン「設定」ボタンのクリック時処理
'//==================================================================================================
Sub RxBtnShowStyleOption(control As Object)
    Call ShowStyleOption
End Sub