<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" xmlns:va="VA_Shared_Namespace">
  <ribbon>
    <tabs>
      <!-- カスタムタブ "VA" -->
     <tab idQ="va:tabVA" label="VA">
        <!-- 「検索」グループ -->
        <group id="grpVASearch" label="VAサーチ">
          <!-- ボタンを追加 -->
          <button id="btnShowSearch" 
                  label="レコード検索" 
                  imageMso="FindDialog" 
                  size="large" 
                  onAction="ShowSearchFormFromRibbon" 
                  supertip="検索フォームを表示します。検索でヒットしたレコードだけを残せます。" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>